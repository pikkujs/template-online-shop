# Copy to .env for local development.
# Every entry here is declared in src/wirings/shop.variable.ts or
# src/wirings/shop.secret.ts, so `pikku all` knows about it and the deploy
# manifest asks for it.

# Local dev needs no DATABASE_URL: `pikku dev` creates .pikku-runtime/dev.db and
# injects it. Set a plain path to use a different sqlite file, or a libsql:// /
# postgres:// URL to run against a remote database.
# DATABASE_URL=./db/shop.sqlite

# Public origin the API is served from — auth callbacks and redirects use it.
BETTER_AUTH_URL=http://localhost:3000

# Signs Better Auth sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Lets `pikku scenario run` sign its actors in through the Better Auth actor
# plugin. Leave unset to disable actor sign-in entirely.
SCENARIO_ACTOR_SECRET=

# Stock level that fires the low-stock trigger.
LOW_STOCK_THRESHOLD=5

# Optional — only needed to take real payments.
STRIPE_SECRET_KEY=

# Needed by the shop assistant agent and by the `shopperAsksTheAssistant`
# scenario. Without it the other scenarios still run.
ANTHROPIC_API_KEY=
